<% /* Halaman Stok Cabang — Admin melihat stok yang terkirim ke tiap cabang */ %>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-store-alt mr-2"></i>Stok Cabang
    </h1>
</div>

<!-- Summary Cards Row -->
<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-3">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Cabang</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800"><%= cabangSummaries.length %></div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-store fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 mb-3">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Stok Tersebar</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            <%= cabangSummaries.reduce((s, c) => s + c.totalStok, 0) %>
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-boxes fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4 col-md-6 mb-3">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Pengiriman Diterima</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            <%= cabangSummaries.reduce((s, c) => s + c.totalShipmentsDiterima, 0) %>
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-truck fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cabang List Table -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Daftar Cabang & Stok</h6>
        <div class="input-group" style="max-width: 250px;">
            <input id="tableSearch" class="form-control form-control-sm" placeholder="Cari cabang ...">
            <div class="input-group-append">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="cabangTable">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Nama Cabang</th>
                        <th>Kota</th>
                        <th>Provinsi</th>
                        <th>Jenis Produk</th>
                        <th>Total Stok</th>
                        <th>Pengiriman Diterima</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (cabangSummaries.length > 0) { %>
                        <% cabangSummaries.forEach((c, idx) => { %>
                        <tr>
                            <td><%= idx + 1 %></td>
                            <td>
                                <i class="fas fa-store-alt text-primary mr-1"></i>
                                <strong><%= c.nama_cabang || c.username || '-' %></strong>
                            </td>
                            <td><%= c.kota || '-' %></td>
                            <td><%= c.provinsi || '-' %></td>
                            <td>
                                <span class="badge badge-primary"><%= c.totalItems %> produk</span>
                            </td>
                            <td>
                                <span class="font-weight-bold <%= c.totalStok > 0 ? 'text-success' : 'text-muted' %>">
                                    <%= c.totalStok %>
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-info"><%= c.totalShipmentsDiterima %> pengiriman</span>
                            </td>
                            <td>
                                <a href="/admin/cabang?cabang=<%= c.id %>" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> Detail
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center text-muted">Belum ada data cabang</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Detail Stok Cabang (jika ada selectedCabang) -->
<% if (selectedCabang) { %>
<div class="card shadow mb-4 border-left-primary" id="detailCabang">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-boxes mr-1"></i>
            Detail Stok — <%= selectedCabang.nama_cabang || selectedCabang.username || '-' %>
        </h6>
        <a href="/admin/cabang" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-times"></i> Tutup
        </a>
    </div>
    <div class="card-body">
        <!-- Info Cabang -->
        <div class="row mb-3">
            <div class="col-md-4">
                <small class="text-muted">Nama Cabang</small><br>
                <strong><%= selectedCabang.nama_cabang || '-' %></strong>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Alamat</small><br>
                <strong><%= [selectedCabang.jalan, selectedCabang.kota, selectedCabang.provinsi].filter(Boolean).join(', ') || '-' %></strong>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Username</small><br>
                <strong><%= selectedCabang.username || '-' %></strong>
            </div>
        </div>
        <hr>

        <!-- Stok Table -->
        <% if (selectedCabang.stocks && selectedCabang.stocks.length > 0) { %>
        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="stockDetailTable">
                <thead class="thead-dark">
                    <tr>
                        <th>#</th>
                        <th>Produk</th>
                        <th>SKU</th>
                        <th>Barcode</th>
                        <th>Divisi</th>
                        <th>Stok Tersedia</th>
                        <th>Satuan</th>
                    </tr>
                </thead>
                <tbody>
                    <% selectedCabang.stocks.forEach((s, idx) => { %>
                    <tr>
                        <td><%= idx + 1 %></td>
                        <td>
                            <% if (s.gambar_url) { %>
                                <img src="<%= s.gambar_url %>" alt="" 
                                     style="width:32px;height:32px;object-fit:cover;border-radius:4px;" 
                                     class="mr-2">
                            <% } %>
                            <strong><%= s.nama_produk %></strong>
                        </td>
                        <td><code><%= s.sku || '-' %></code></td>
                        <td><%= s.barcode || '-' %></td>
                        <td>
                            <% if (s.divisi) { %>
                                <span class="badge badge-secondary"><%= s.divisi %></span>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td>
                            <span class="font-weight-bold <%= s.stok > 0 ? 'text-success' : 'text-danger' %>">
                                <%= s.stok %>
                            </span>
                        </td>
                        <td><%= s.satuan || '-' %></td>
                    </tr>
                    <% }) %>
                </tbody>
                <tfoot>
                    <tr class="font-weight-bold bg-light">
                        <td colspan="5" class="text-right">Total Stok:</td>
                        <td class="text-success">
                            <%= selectedCabang.stocks.reduce((sum, s) => sum + s.stok, 0) %>
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <% } else { %>
            <div class="text-center py-4 text-muted">
                <i class="fas fa-inbox fa-3x mb-3"></i>
                <p>Belum ada stok terkirim ke cabang ini</p>
            </div>
        <% } %>
    </div>
</div>
<% } %>

<!-- DataTables -->
<link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net/1.13.6/jquery.dataTables.min.js"></script>
<script
    src="https://cdnjs.cloudflare.com/ajax/libs/datatables.net-bs4/1.13.6/dataTables.bootstrap4.min.js"></script>

<script>
    $(function () {
        // DataTable untuk tabel cabang
        const dt = $('#cabangTable').DataTable({
            pageLength: 10,
            lengthChange: false,
            order: [[1, 'asc']],
            language: {
                search: "Cari:",
                paginate: { previous: "Sebelumnya", next: "Selanjutnya" },
                info: "Menampilkan _START_ s/d _END_ dari _TOTAL_ cabang",
                emptyTable: "Tidak ada data cabang"
            }
        });
        $('#cabangTable_filter').hide();
        $('#tableSearch').on('keyup', function () { dt.search(this.value).draw(); });

        // DataTable untuk detail stok (jika ada)
        <% if (selectedCabang && selectedCabang.stocks && selectedCabang.stocks.length > 0) { %>
        $('#stockDetailTable').DataTable({
            pageLength: 25,
            lengthChange: false,
            order: [[1, 'asc']],
            language: {
                search: "Cari:",
                paginate: { previous: "Sebelumnya", next: "Selanjutnya" },
                info: "Menampilkan _START_ s/d _END_ dari _TOTAL_ produk",
            }
        });

        // Scroll ke detail
        $('html, body').animate({ scrollTop: $('#detailCabang').offset().top - 80 }, 400);
        <% } %>
    });
</script>
