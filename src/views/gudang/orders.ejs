<div class="container-fluid">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
        .container-fluid { font-family: 'Inter', sans-serif; }
        .aesthetic-card { border: none; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.04),0 1px 3px rgba(0,0,0,0.02) !important; background: #fff; overflow: hidden; }
        .aesthetic-header { background: rgba(248,249,252,0.8) !important; backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,0,0,0.03) !important; padding: 1.5rem !important; }
        .pill-badge { padding: 0.5em 1.2em !important; border-radius: 50rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; font-size: 0.75em !important; color: white !important; }
        .badge-approved_admin { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
        .badge-dipaket { background: linear-gradient(135deg, #f6c23e 0%, #dda20a 100%); }
        .badge-dikirim { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); }
        .kode-highlight { color: #4e73df; background: #eaecfb; padding: 4px 10px; border-radius: 6px; font-weight: 800; }
        .btn-pack { background: linear-gradient(135deg, #f6c23e 0%, #dda20a 100%); color: #fff; box-shadow: 0 4px 12px rgba(246,194,62,0.3); }
        .btn-pack:hover { transform: translateY(-2px); color: #fff; }
        .btn-send { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); color: #fff; box-shadow: 0 4px 12px rgba(28,200,138,0.3); }
        .btn-send:hover { transform: translateY(-2px); color: #fff; }
    </style>

    <div class="d-sm-flex align-items-center justify-content-between mb-4 mt-2">
        <h1 class="h3 mb-0 page-title">Pengemasan</h1>
    </div>

    <div class="card aesthetic-card mb-3">
        <div class="card-body py-3">
            <div class="d-flex align-items-center flex-wrap" style="gap:12px;">
                <label class="font-weight-bold text-gray-700 mb-0" style="font-size:0.9rem;">
                    <i class="fas fa-filter mr-1"></i> Filter
                </label>
                <select id="filterStatus" class="form-control form-control-sm" style="max-width:180px;">
                    <option value="">Semua Status</option>
                    <option value="approved_admin">Siap Dikemas</option>
                    <option value="dipaket">Sedang Diproses</option>
                    <option value="dikirim">Sudah Dikirim</option>
                </select>
                <button id="filterResetBtn" class="btn btn-sm btn-outline-secondary"><i class="fas fa-undo"></i> Reset</button>
            </div>
        </div>
    </div>

    <% var list = Array.isArray(orders) ? orders : []; %>

    <% if (list.length === 0) { %>
        <div class="card aesthetic-card">
            <div class="card-body text-center py-5">
                <i class="fas fa-boxes fa-3x text-gray-300 mb-3"></i>
                <p class="mb-0 text-muted">Tidak ada pesanan untuk dikemas.</p>
            </div>
        </div>
    <% } %>

    <% for (var si = 0; si < list.length; si++) { %>
        <%
            var o = list[si];
            var st = (o.status || '').toLowerCase();
            var cabang = (usersMap && usersMap[o.cabang_id]) ? usersMap[o.cabang_id] : null;

            var badgeClass = 'pill-badge badge-approved_admin';
            if (st === 'dipaket') badgeClass = 'pill-badge badge-dipaket';
            if (st === 'dikirim') badgeClass = 'pill-badge badge-dikirim';
        %>

        <div class="card aesthetic-card mb-3" data-status="<%= st %>">
            <div class="card-header aesthetic-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="font-weight-bold mb-1">
                        <span class="kode-highlight"><%= o.kode_order %></span>
                        <% if (o.kode_pengiriman) { %>
                            <span class="ml-2 small text-muted">Resi: <%= o.kode_pengiriman %></span>
                        <% } %>
                    </div>
                    <small class="text-muted">
                        <i class="fas fa-store mr-1"></i> <%= cabang ? cabang.username || cabang.nama_cabang : o.cabang_id %>
                    </small>
                </div>
                <span class="<%= badgeClass %>">
                    <% if (st === 'approved_admin') { %>SIAP DIKEMAS<% } %>
                    <% if (st === 'dipaket') { %>DIKEMAS<% } %>
                    <% if (st === 'dikirim') { %>DIKIRIM<% } %>
                </span>
            </div>
            <div class="card-body px-4 py-3">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <small class="text-muted">Total: <strong>Rp <%= (o.total_harga || 0).toLocaleString('id-ID') %></strong></small>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">Item: <strong><%= (o.items || []).length %></strong></small>
                    </div>
                    <div class="col-md-4 text-md-right">
                        <small class="text-muted"><%= (o.catatan_packing || '-') %></small>
                    </div>
                </div>

                <div class="d-flex" style="gap:10px;">
                    <a href="/gudang/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye mr-1"></i> Detail
                    </a>
                    <% if (st === 'approved_admin') { %>
                    <button class="btn btn-sm btn-pack" onclick="packOrder('<%= o.id %>')">
                        <i class="fas fa-box mr-1"></i> Tandai Dikemas
                    </button>
                    <% } %>
                    <% if (st === 'dipaket') { %>
                    <button class="btn btn-sm btn-send" onclick="sendOrder('<%= o.id %>')">
                        <i class="fas fa-truck mr-1"></i> Kirim Barang
                    </button>
                    <% } %>
                </div>
            </div>
        </div>
    <% } %>
</div>

<!-- Pack Modal -->
<div class="modal fade" id="modalPack" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="formPack" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h5 class="modal-title">Tandai Dikemas</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Konfirmasi bahwa pesanan ini sudah dikemas dan siap dikirim.</p>
                <div class="form-group">
                    <label>Catatan Packing (opsional)</label>
                    <textarea name="catatan_packing" class="form-control" rows="3" placeholder="Contoh: dus karton, segel aman"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-warning" type="submit"><i class="fas fa-box mr-1"></i> Tandai Dikemas</button>
            </div>
        </form>
    </div>
</div>

<!-- Send Modal -->
<div class="modal fade" id="modalSend" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="formSend" method="POST" class="modal-content">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal-header">
                <h5 class="modal-title">Kirim Barang</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-2"></i>
                    Barang akan dikirim ke cabang dan resi pengiriman akan dibuat otomatis.
                </div>
                <p class="text-muted mb-0">Lanjutkan pengiriman barang ini?</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Batal</button>
                <button class="btn btn-success" type="submit"><i class="fas fa-truck mr-1"></i> Ya, Kirim</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function() {
        var params = new URLSearchParams(window.location.search);
        var ok = params.get('ok'), err = params.get('err');

        if (ok && typeof Swal !== 'undefined') {
            var title = ok;
            if (ok === 'packed') title = 'Pesanan ditandai sudah dikemas!';
            if (ok === 'sent') title = 'Barang berhasil dikirim!';
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title, showConfirmButton: false, timer: 3000, timerProgressBar: true });
            params.delete('ok'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }
        if (err && typeof Swal !== 'undefined') {
            Swal.fire({ icon: 'error', title: 'Gagal', text: err });
            params.delete('err'); window.history.replaceState({}, '', location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }

        // Filter
        var filterStatus = document.getElementById('filterStatus');
        var filterResetBtn = document.getElementById('filterResetBtn');
        var cards = document.querySelectorAll('.card.aesthetic-card.mb-3[data-status]');

        function applyFilter() {
            var val = filterStatus.value;
            var visible = 0;
            cards.forEach(function(c) {
                var match = !val || c.getAttribute('data-status') === val;
                c.style.display = match ? '' : 'none';
                if (match) visible++;
            });
        }
        filterStatus.addEventListener('change', applyFilter);
        filterResetBtn.addEventListener('click', function() { filterStatus.value = ''; applyFilter(); });
    })();

    function packOrder(id) {
        var form = document.getElementById('formPack');
        form.action = '/gudang/orders/' + id + '/pack';
        form.querySelector('textarea').value = '';
        $('#modalPack').modal('show');
    }

    function sendOrder(id) {
        var form = document.getElementById('formSend');
        form.action = '/gudang/orders/' + id + '/send';
        $('#modalSend').modal('show');
    }
</script>
